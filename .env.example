# =====================================================================
#  VARIABLES D'ENVIRONNEMENT
#  Copie ce fichier vers .env puis remplis les valeurs.
#  Le fichier .env n'est JAMAIS envoye sur GitHub (voir .gitignore).
#  Ne partage ces valeurs avec personne.
# =====================================================================

# --- Cles API Binance -------------------------------------------------
# TESTNET (argent fictif) : https://testnet.binancefuture.com
#   Connecte-toi avec GitHub/Google, onglet "API Key" en bas de page.
# REEL : https://www.binance.com/en/my/settings/api-management
#   IMPORTANT : active "Enable Futures", et surtout PAS "Enable Withdrawals".
#   Le bot refuse de demarrer avec une cle autorisant les retraits.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Notifications Discord (optionnel) --------------------------------
# Pour recevoir les trades, les alertes et les resumes sur ton telephone.
# Comment obtenir cette URL :
#   1. Sur ton serveur Discord, clique sur la roue dentee d'un salon
#   2. Integrations -> Webhooks -> Nouveau webhook
#   3. Copie l'URL du webhook et colle-la ci-dessous
# Verifie ensuite avec : ./run.sh --test-alerts
DISCORD_WEBHOOK_URL=
